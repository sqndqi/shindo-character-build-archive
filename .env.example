# Archive Server — environment variables
# Copy relevant vars to your deployment platform. Do NOT commit real values.

# Owner login username (e.g. sendai)
OWNER_USERNAME=your_username_here

# Argon2id/bcrypt hash of the owner password.
# Generate with: cd server && node scripts/gen-password-hash.mjs
OWNER_PASSWORD_HASH=your_bcrypt_hash_here

# ----------------------------------------------------------- second owner
# Optional. The archive supports two owner accounts, each with its own login
# and its own local user row. Leave BOTH of the following unset to run with a
# single owner. Setting only one of the pair fails the seed with a clear error
# rather than creating a partially configured owner.
#
# The second owner must use a different username from OWNER_USERNAME.
# OWNER_2_USERNAME=your_second_username_here
# OWNER_2_PASSWORD_HASH=your_second_bcrypt_hash_here

# Random secret for signing session cookies (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_long_random_secret_here

# URL of the frontend (no trailing slash). Used for CORS allowlist.
FRONTEND_ORIGIN=https://your-username.github.io

# Node environment: production | development | test
NODE_ENV=production

# Server port (default 3211)
PORT=3211
